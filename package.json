{
  "name": "oraycss",
  "version": "0.1.2",
  "description": "Zero-dependency, ahead-of-time utility-first CSS framework and ready-to-use UI component suite",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "oraycss": "./bin/oraycss.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "css",
    "oraycss",
    "oray",
    "utility-first",
    "compiler",
    "zero-dependency",
    "design-system",
    "components",
    "ui-kit",
    "tailwind",
    "atomic-css",
    "aot"
  ],
  "author": "dwmk",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node ./bin/oraycss.js build",
    "dev": "node server.js",
    "start": "node server.js",
    "lint": "node --check bin/oraycss.js && node --test tests/*.test.js",
    "test": "node --test tests/*.test.js",
    "inspect": "node ./bin/oraycss.js inspect"
  },
  "dependencies": {},
  "devDependencies": {}
}
